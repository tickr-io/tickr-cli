# Repo-local data-plane development defaults. `.env.local` is ignored and may
# override these values for one checkout.
TICKR_CLI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load checkout-local overrides before deriving connection URLs from the
# development infrastructure credentials.
if declare -F dotenv_if_exists >/dev/null 2>&1; then
  dotenv_if_exists .env.local
elif [[ -f "${TICKR_CLI_ROOT}/.env.local" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${TICKR_CLI_ROOT}/.env.local"
  set +a
fi

export TICKR_DEV_POSTGRES_USER="${TICKR_DEV_POSTGRES_USER:-postgres}"
export TICKR_DEV_POSTGRES_PASSWORD="${TICKR_DEV_POSTGRES_PASSWORD:-postgres}"
export TICKR_DEV_MINIO_ROOT_USER="${TICKR_DEV_MINIO_ROOT_USER:-minioadmin}"
export TICKR_DEV_MINIO_ROOT_PASSWORD="${TICKR_DEV_MINIO_ROOT_PASSWORD:-minioadmin}"
export TICKR_DSL_PATHS="${TICKR_DSL_PATHS:-${TICKR_CLI_ROOT}/dsl}"
export TICKR_TENANT_SLUG="${TICKR_TENANT_SLUG:-local-dev}"
export TICKR_NATS_URL="${TICKR_NATS_URL:-nats://127.0.0.1:4222}"
export TICKR_CONDUCTOR_POSTGRES_URL="${TICKR_CONDUCTOR_POSTGRES_URL:-postgres://${TICKR_DEV_POSTGRES_USER}:${TICKR_DEV_POSTGRES_PASSWORD}@127.0.0.1:5432/tickr}"
export TICKR_COORDINATOR_HTTP_URL="${TICKR_COORDINATOR_HTTP_URL:-http://127.0.0.1:8000}"
export TICKR_COORDINATOR_RELAY_URL="${TICKR_COORDINATOR_RELAY_URL:-http://127.0.0.1:9095}"
export TICKR_API_BIND_ADDR="${TICKR_API_BIND_ADDR:-127.0.0.1:6000}"
export TICKR_LOG_STORAGE_ENDPOINT="${TICKR_LOG_STORAGE_ENDPOINT:-http://127.0.0.1:9000}"
export TICKR_LOG_STORAGE_BUCKET="${TICKR_LOG_STORAGE_BUCKET:-tickr-logs}"
export TICKR_LOG_STORAGE_ACCESS_KEY_ID="${TICKR_LOG_STORAGE_ACCESS_KEY_ID:-${TICKR_DEV_MINIO_ROOT_USER}}"
export TICKR_LOG_STORAGE_SECRET_ACCESS_KEY="${TICKR_LOG_STORAGE_SECRET_ACCESS_KEY:-${TICKR_DEV_MINIO_ROOT_PASSWORD}}"
export TICKR_LOG_STORAGE_REGION="${TICKR_LOG_STORAGE_REGION:-ap-southeast-1}"
export RUST_LOG="${RUST_LOG:-info,tickr=debug}"

unset TICKR_CLI_ROOT

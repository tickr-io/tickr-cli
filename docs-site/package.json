{
  "name": "tickr-docs",
  "version": "0.1.2",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "scripts": {
    "start": "npm run gen-api-docs && docusaurus start",
    "gen-api-docs": "docusaurus gen-api-docs tickr",
    "build": "npm run gen-api-docs && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "5.1.3",
    "docusaurus-plugin-sass": "0.2.6",
    "docusaurus-theme-openapi-docs": "5.1.3",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "openapi-to-postmanv2": {
      "yaml": "1.10.3"
    },
    "js-yaml@4.3.0": "4.3.1",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1"

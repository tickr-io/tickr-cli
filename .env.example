# Copy to .env.local for one checkout. Do not commit real credentials.
TICKR_DEV_POSTGRES_USER=replace-user
TICKR_DEV_POSTGRES_PASSWORD=replace-password
TICKR_DEV_MINIO_ROOT_USER=replace-storage-user
TICKR_DEV_MINIO_ROOT_PASSWORD=replace-storage-password
TICKR_TENANT_SLUG=local-dev
TICKR_API_BIND_ADDR=127.0.0.1:6000
# To open the Vite Console from another machine, bind it on the LAN and list
# every accepted Host header as a comma-separated value:
# TICKR_VITE_HOST=0.0.0.0
# TICKR_VITE_ALLOWED_HOSTS=tardunges-mac-mini
TICKR_NATS_URL=nats://127.0.0.1:4222
# Postgres is selected when TICKR_SQL_BACKEND is unset (or explicitly postgres);
# it does not require TICKR_SQL_TOPOLOGY.
TICKR_CONDUCTOR_POSTGRES_URL=postgres://user:replace-me@127.0.0.1:5432/tickr
# SQLite is opt-in and requires both selectors:
# TICKR_SQL_BACKEND=sqlite
# TICKR_SQL_TOPOLOGY=single-node
# TICKR_CONDUCTOR_SQLITE_URL=sqlite:///var/lib/tickr/data-plane.db
TICKR_COORDINATOR_HTTP_URL=http://127.0.0.1:8000
TICKR_COORDINATOR_RELAY_URL=http://127.0.0.1:9095
TICKR_LOG_STORAGE_ENDPOINT=http://127.0.0.1:9000
TICKR_LOG_STORAGE_BUCKET=tickr-logs
TICKR_LOG_STORAGE_ACCESS_KEY_ID=replace-me
TICKR_LOG_STORAGE_SECRET_ACCESS_KEY=replace-me
TICKR_LOG_STORAGE_REGION=us-east-1

{
  "name": "tickr-console",
  "private": true,
  "version": "0.1.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tickr-io/tickr-cli.git",
    "directory": "console"
  },
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "generate-openapi": "cargo run --manifest-path ../Cargo.toml -p tickr_api --bin generate_openapi",
    "check-openapi": "cargo run --manifest-path ../Cargo.toml -p tickr_api --bin generate_openapi -- --check",
    "generate-api": "openapi-typescript ./openapi.yaml -o ./src/api/types.gen.ts",
    "generate-contract": "npm run generate-openapi && npm run generate-api",
    "check-api": "tmp=$(mktemp) && openapi-typescript ./openapi.yaml -o $tmp >/dev/null && cmp -s $tmp ./src/api/types.gen.ts; status=$?; rm -f $tmp; exit $status"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.525.0",
    "openapi-fetch": "^0.13.0",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.6"
  }
}
